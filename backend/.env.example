# Copy to .env and fill in. `.env` is git-ignored -- never commit real credentials.
#
# Every value below has a working default in src/main/resources/application.yaml, so the app boots
# with this file absent. You only need it for AWS access keys and for overriding anything that
# differs from the compose.yaml defaults.
#
# Loaded by `spring.config.import: "optional:file:.env[.properties]"`. The `[.properties]` hint is
# required -- without it Spring parses the file as YAML and fails on KEY=value lines.

# --- AWS (only needed for media uploads; leave MEDIA_BUCKET empty to run without media) ---------
# The SDK cannot see variables imported this way on its own, so MediaConfig reads these two from the
# Spring Environment and builds a StaticCredentialsProvider when both are present. With neither set
# it falls back to the SDK default chain (instance role, web identity, shared profile) -- which is
# what production should use.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Private bucket that holds attachments. Empty disables the media endpoints (they return 503
# MEDIA_NOT_CONFIGURED) rather than failing startup.
MEDIA_BUCKET=
AWS_REGION=us-east-1

# --- Secrets: override in every non-local environment -------------------------------------------
# Must be >= 32 bytes for HS256.
JWT_SECRET=
# AES-256-GCM key for message content at rest. Server-side encryption, not end-to-end.
MESSAGE_ENCRYPTION_KEY=

# --- Overrides (only if your local setup differs from compose.yaml) ------------------------------
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=whatsapp_clone
# POSTGRES_USER=whatsapp_user
# POSTGRES_PASSWORD=whatsapp_secret
# REDIS_HOST=localhost
# REDIS_PORT=6379
# RABBITMQ_HOST=localhost
# RABBITMQ_STOMP_PORT=61613
# RABBITMQ_USER=whatsapp
# RABBITMQ_PASSWORD=whatsapp_secret
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# SERVER_PORT=8080