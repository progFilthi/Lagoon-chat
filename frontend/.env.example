# Copy to .env.local. `.env*` is git-ignored -- never commit real values.
#
# All of these are optional. With none of them set the frontend talks to http://localhost:8080 and
# derives the WebSocket URL from it, which is correct for local development.

# Where the Spring Boot backend lives. Server-side only -- used by the /api/b proxy and the auth
# route handlers, so it is never exposed to the browser.
BACKEND_URL=http://localhost:8080

# Browser-visible backend URL. Only needed when the WebSocket should not be derived from the page's
# own host -- for example when the backend runs on a different host during a live demo.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Explicit WebSocket endpoint. Takes precedence over NEXT_PUBLIC_BACKEND_URL.
# NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8080/ws